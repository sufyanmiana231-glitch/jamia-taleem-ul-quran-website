# ─────────────────────────────────────────────────────────────────────────
# Firebase configuration — Jamia Taleem-ul-Quran Management System
#
# The Firebase Web SDK config below is not a secret (it identifies the
# project, it does not authorize access — access is controlled by
# firestore.rules and Firebase Auth). It is still kept out of source
# control and out of the repo so each environment (dev/staging/prod) can
# point at its own Firebase project without code changes.
#
# Copy this file to `.env.local` and fill in the values from:
# Firebase Console → Project settings → General → Your apps → Web app
#
# Known project details (provided by the client):
#   Project name: Jamia-taleem-ul-quran-database
#   Project ID:   jamia-taleem-ul-quran-database
#   Project #:    182107148945
#
# Until these are filled in, the app runs with Firebase disabled: pages
# render, but data operations show a "Firebase not connected" state
# instead of crashing. See src/lib/firebase/config.ts.
# ─────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=jamia-taleem-ul-quran-database.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=jamia-taleem-ul-quran-database
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=jamia-taleem-ul-quran-database.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=182107148945
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: only needed if you enable Firebase Analytics
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
